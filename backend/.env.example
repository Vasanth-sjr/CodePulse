# ─── Required ───
GITHUB_TOKEN=your_personal_access_token

# ─── Database ───
# SQLite (default, works locally and on Railway/Render — data resets on redeploy)
DATABASE_URL=sqlite:///./codepulse.db
# PostgreSQL (persistent — use Railway Postgres addon or Render managed DB)
# DATABASE_URL=postgresql://user:password@host:5432/codepulse

# ─── CORS ───
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://codepulse.vercel.app,https://codepulse-ai.vercel.app,https://codepulse-app.vercel.app,https://codepulse-intel.vercel.app

# ─── AI API Keys ───
GEMINI_API_KEY=your_gemini_key
OPENAI_API_KEY=your_openai_key

# ─── Optional ───
N8N_WEBHOOK_URL=http://localhost:5678/webhook/start-analysis
PORT=8000
